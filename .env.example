# Copy this file to .env and fill in the values marked REQUIRED.
# Never commit .env — it is listed in .gitignore.

# --- LLM (REQUIRED: GROQ_API_KEY) ---
# Free key from the Groq console. Every example/route that calls the LLM needs it.
GROQ_API_KEY=
LLM_PROVIDER=groq
# Model names change: Groq retires models over time. If you get a "model not found" error,
# pick a current chat model from your Groq console (or `client.models.list()`) and set it here.
LLM_MODEL=openai/gpt-oss-20b
# The tool-calling agent (stock, vendor and incident lookups) uses its own model, because
# gpt-oss-20b often fails when a question needs several tool calls (2 of 8 runs worked,
# against 8 of 8 for gpt-oss-120b). Leave this line out to use the default shown, or set
# it to an empty value (TOOLS_LLM_MODEL=) to use LLM_MODEL for tools as well.
TOOLS_LLM_MODEL=openai/gpt-oss-120b
# 0 = most deterministic answers (best for RAG and evaluation)
TEMPERATURE=0

# --- Chunking and retrieval ---
# How big each document chunk is (characters) and how much neighbouring chunks overlap.
# Used by the recursive splitter; the semantic splitter chooses its own boundaries.
# Larger defaults to try when you experiment: CHUNK_SIZE=1000, CHUNK_OVERLAP=200, RETRIEVAL_K=4
CHUNK_SIZE=300
CHUNK_OVERLAP=50
# How many chunks are passed to the LLM after retrieval/reranking.
RETRIEVAL_K=2
# Where the Chroma vector index is stored (rebuilt automatically when DOCUMENT_VERSION changes).
VECTORSTORE_DIR=vectorstore/chroma
# Change this string after editing files in data/ to force the index to rebuild.
DOCUMENT_VERSION=2026-06-08-v1

# --- Feature toggles (true/false) ---
# Generate several rephrasings of the question and merge their results.
ENABLE_MULTI_QUERY=true
# Split documents where the meaning changes instead of at fixed sizes.
ENABLE_SEMANTIC_CHUNKING=true
# Re-score retrieved chunks with a cross-encoder (downloads a small HuggingFace model on first use).
ENABLE_RERANKING=true
# After reranking, drop chunks scoring below this (the best chunk is always kept) so
# irrelevant text isn't sent to the LLM. Scores run about -11 (unrelated) to +9 (strong
# match); -9.0 was chosen by measuring this project's small document set, so re-measure
# for your own data. Use RERANK_MIN_SCORE=none to always keep exactly RETRIEVAL_K chunks.
RERANK_MIN_SCORE=-9.0

# --- LangSmith tracing (OPTIONAL) ---
# Tracing needs LANGSMITH_API_KEY. If you don't have one, set LANGSMITH_TRACING=false.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=retailops-ai-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- App / API ---
# Shown in logs and trace tags.
APP_ENV=local
APP_VERSION=0.2.0
# Clients send this in the x-api-key header. Change it for anything beyond local learning.
APP_API_KEY=change_this_local_dev_key
